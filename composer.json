{
    "name": "colorlibhq/gentelella-laravel",
    "description": "Official Gentelella v4 integration for Laravel — vanilla JS, SCSS, no Bootstrap, no jQuery, Vite-ready.",
    "keywords": [
        "laravel",
        "gentelella",
        "admin",
        "dashboard",
        "template",
        "blade",
        "crud",
        "vite"
    ],
    "homepage": "https://gentelella.colorlib.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Colorlib",
            "homepage": "https://colorlib.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ColorlibHQ/gentelella-laravel/issues",
        "source": "https://github.com/ColorlibHQ/gentelella-laravel"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "ColorlibHQ\\Gentelella\\": "src/",
            "ColorlibHQ\\Gentelella\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ColorlibHQ\\Gentelella\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the Pest test suite",
        "lint": "Check code style with Pint (no changes)",
        "fix": "Fix code style with Pint",
        "analyse": "Run PHPStan static analysis",
        "check": "Run lint, analyse and test (what CI runs)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ColorlibHQ\\Gentelella\\GentelellaServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
